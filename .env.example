# Copy to .env and adjust. Every setting can also be set as a real environment variable.

# Leave DEBUG on for local development only.
OCP_DEBUG=1
OCP_SECRET_KEY=change-me
OCP_ALLOWED_HOSTS=localhost,127.0.0.1
OCP_BASE_URL=http://localhost:8000

# sqlite:///db.sqlite3 (default) or postgres://user:password@host:5432/dbname
OCP_DATABASE_URL=sqlite:///db.sqlite3

# Payments: "test" (built-in, no real money) or "stripe".
OCP_PAYMENT_PROVIDER=test
OCP_STRIPE_SECRET_KEY=
OCP_STRIPE_WEBHOOK_SECRET=

# Email: console prints emails to the terminal. Use django.core.mail.backends.smtp.EmailBackend for real sending.
OCP_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
OCP_DEFAULT_FROM_EMAIL=Open Conference Platform <no-reply@localhost>
OCP_EMAIL_HOST=
OCP_EMAIL_PORT=587
OCP_EMAIL_HOST_USER=
OCP_EMAIL_HOST_PASSWORD=
OCP_EMAIL_USE_TLS=1

# Use Google Fonts for the interface typefaces. Set to 0 to use system fonts only.
OCP_GOOGLE_FONTS=1

# Password for the demo accounts that `manage.py seed_demo` creates. Local development only.
OCP_DEMO_PASSWORD=

# Exact frontend origins for local API integration, comma-separated.
OCP_FRONTEND_ORIGINS=http://localhost:5173
OCP_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# For production, use deploy/production.env.example and ocp.settings.production.
