# Copy to .env.production; supply real values outside source control.
DJANGO_SETTINGS_MODULE=ocp.settings.production
OCP_DEBUG=0
OCP_SECRET_KEY=
OCP_ALLOWED_HOSTS=api.example.com
OCP_BASE_URL=https://api.example.com
OCP_FRONTEND_ORIGINS=https://app.example.com
OCP_CSRF_TRUSTED_ORIGINS=https://app.example.com
OCP_DATABASE_URL=postgresql://ocp:REPLACE_ME@db:5432/ocp
POSTGRES_PASSWORD=
OCP_BEHIND_PROXY=1
OCP_HSTS_SECONDS=3600
OCP_SESSION_COOKIE_SAMESITE=Lax
OCP_PAYMENT_PROVIDER=stripe
OCP_STRIPE_SECRET_KEY=
OCP_STRIPE_WEBHOOK_SECRET=
OCP_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
OCP_DEFAULT_FROM_EMAIL=Open Conference Platform <tickets@example.com>
OCP_EMAIL_HOST=
OCP_EMAIL_PORT=587
OCP_EMAIL_HOST_USER=
OCP_EMAIL_HOST_PASSWORD=
OCP_EMAIL_USE_TLS=1
OCP_GOOGLE_FONTS=0
